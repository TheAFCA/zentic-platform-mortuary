# Normalize line endings
* text=auto eol=lf

# Force LF for these files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.prisma text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.pdf binary
*.woff binary
*.woff2 binary
