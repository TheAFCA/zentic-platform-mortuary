# =============================================================================
# ZENTIC.pro — Variables de entorno
# Copiar este archivo como .env y completar los valores
# NUNCA commitear el archivo .env con valores reales
# =============================================================================

# Base de datos
DATABASE_URL=postgresql://zentic:password@localhost:5545/zentic_dev
DATABASE_SHADOW_URL=postgresql://zentic:password@localhost:5546/zentic_shadow

# Autenticación JWT
JWT_SECRET=change-me-super-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Redis
REDIS_URL=redis://localhost:6379

# Streaming
STREAM_PROVIDER=mux # "mux" o "cloudflare"
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
STREAM_ACCESS_SECRET=change-me-stream-access-secret-min-32-chars
STREAM_ACCESS_TOKEN_TTL_SECONDS=7200

# Almacenamiento (Cloudflare R2 o AWS S3)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zentic-dev
R2_PUBLIC_URL=

# Email transaccional
EMAIL_PROVIDER=resend # Proveedor de correo. Usa "resend" para enviar emails reales.
RESEND_API_KEY= # API key de Resend. Se obtiene creando una key en https://resend.com/dashboard
EMAIL_FROM=noreply@homena.pro # Remitente verificado en Resend. Debe ser un dominio/correo autorizado.

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000
PLATFORM_DOMAIN=localhost
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
