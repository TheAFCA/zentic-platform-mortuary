{
  "name": "@zentic/shared-types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for ZENTIC.pro (backend + frontend)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
