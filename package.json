{
  "name": "zentic-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ZENTIC.pro — SaaS multi-tenant platform for funeral homes",
  "scripts": {
    "dev": "pnpm --filter @zentic/shared-types build && pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @zentic/api dev",
    "dev:web": "pnpm --filter @zentic/web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @zentic/api build",
    "build:web": "pnpm --filter @zentic/web build",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @zentic/api test",
    "test:web": "pnpm --filter @zentic/web test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "bcrypt": "^6.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
